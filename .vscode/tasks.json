{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🐍 BookService",
            "type": "shell",
            "command": "source .venv/bin/activate && uvicorn main:app --reload --port 8000",
            "options": {
                "cwd": "${workspaceFolder}/app/BookService"
            },
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "group": "nootra"
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
